@page
@using DailyReport.Models
@model DailyReport.Pages.FireReport.FireRepIndexModel
@{
    ViewData["Title"] = "Пожарная сводка";
}
<div class="text-center">
    <h1 class="display-4">Пожарная сводка отделений</h1>

    @{
        foreach (Department dep in Model.Departments)
        {
            <p><a href="FireReport?depAllias=@dep.Allias">@dep.Name </a></p>
        }
    }
    
    <p><a href="FireSumReport">Сводка по больнице</a></p>

</div>