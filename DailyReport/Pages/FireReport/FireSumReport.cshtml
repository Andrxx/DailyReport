@page
@using DailyReport.Models
@using DailyReport.Models.DTO
@model DailyReport.Pages.FireReport.FireSumReportModel
@{
    ViewData["Title"] = "Пожарная сводка";
}
<div class="row">
    <h2>Дежурные медсестры на @DateTime.Now.ToString("dd.MM.yy")</h2>
</div>

@{
    foreach (FullFireReport ffr in Model.fullFireReports)
    {
        <div class="row fw-bold pt-1">
            <h4>@ffr.Department.Name</h4>
        </div>
        <div class="row">
            <div class="row fw-weight-lighter">
                <div class="col-5 offset-1"> <h5>Ф.И.О.</h5></div>
                <div class="col-5"><h5>Телефон</h5></div>

            </div>
            @{
                foreach (DutyNurse dutyNurse in ffr.Nurses)
                {
                    <div class="row border-bottom">
                        <div class="col-5 offset-1">@dutyNurse.name</div>
                        <div class="col-5 fs-3">@dutyNurse.Phone</div>
                    </div>
                }
            }
        </div>
    }
}



<div class="container d-print-none">
<div class="row">
    <h2>Пожарная сводка</h2>
</div>

<div class="row text-end fw-bold">
    <div class=" col-2">Отделение</div>
    <div class=" col-1">Взр</div>
    <div class=" col-1">Дети</div>
    <div class=" col-1">Уход</div>
    <div class=" col-1">Сотр</div>
    <div class=" col-1">Всего взр</div>
    <div class=" col-1">Всего дет</div>
    <div class=" col-2">Время сводки</div>
</div>
@{
    foreach (FullFireReport ffr in Model.fullFireReports)
    {
        <div class="row text-end">
            <div class=" col-2 border border-dark">@ffr.Department.Name</div>
            <div class=" col-1 border border-dark">@ffr.FireReport.Adult</div>
            <div class=" col-1 border border-dark">@ffr.FireReport.Children</div>
            <div class=" col-1 border border-dark">@ffr.FireReport.Care</div>
            <div class=" col-1 border border-dark">@ffr.FireReport.Personel</div>
            <div class=" col-1 border border-dark">@(@ffr.FireReport.Adult + @ffr.FireReport.Care)</div>
            <div class=" col-1 border border-dark">@ffr.FireReport.Children</div>
            <div class=" col-2 border border-dark">@ffr.FireReport.Date.ToString("HH:mm dd.MM.yy")</div>
        </div>
    }
}
    <button class="d-print-none mt-2 action-print">Печать</button>
</div>
