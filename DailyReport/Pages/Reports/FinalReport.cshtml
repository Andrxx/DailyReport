                                        <td >@if(dr.oIVL > 0) @dr.oIVL </td>
                                        <td >@if(dr.oIVLChildrens > 0) @dr.oIVLChildrens</td>
                        }
                    }
                    <td >@Model.finalReport.oIVL</td>
                    <td>@Model.finalReport.oIVLChildren</td>
                    <td >@(@Model.finalReport.oIVL + @Model.finalReport.oIVLChildren)</td>
                    <td colspan="3" class="bg-transparent border-0"></td>
                </tr>
                <tr class="border-transparent print-m-p-0">
                    <td class="fw-bold">НИВЛ </td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td >@if(dr.oNIVL > 0) @dr.oNIVL </td>
                                        <td >@if(dr.oNIVLChildrens > 0) @dr.oNIVLChildrens</td>
                        }
                    }
                    <td>@Model.finalReport.oNIVL</td>
                    <td>@Model.finalReport.oNIVLChildren</td>
                    <td>@(@Model.finalReport.oNIVL + @Model.finalReport.oNIVLChildren)</td>
