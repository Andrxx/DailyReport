                </tr>
                <tr class="border-transparent print-m-p-0">
                    <td class="fw-bold">НИВЛ+ВПО</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td >@if(dr.oNIVLVPO > 0) @dr.oNIVLVPO </td>
                                        <td >@if(dr.oNIVLVPOChildrens > 0) @dr.oNIVLVPOChildrens </td>
                        }
                    }
                    <td>@Model.finalReport.oNIVLVPO</td>
                    <td>@Model.finalReport.oNIVLVPOChildren</td>
                    <td>@(@Model.finalReport.oNIVLVPO + @Model.finalReport.oNIVLVPOChildren)</td>
                    <td colspan="3" class="bg-transparent border-0"></td>
                </tr>
                <tr class="border-transparent print-m-p-0">
                    <td class="fw-bold">НИВЛ+КМ</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td >@if(dr.oNIVLMask > 0) @dr.oNIVLMask </td>
                                        <td >@if(dr.oNIVLMaskChildrens > 0) @dr.oNIVLMaskChildrens </td>
                        }
                    }
                    <td>@Model.finalReport.oNIVLMask</td>
                    <td>@Model.finalReport.oNIVLMaskChildren</td>
                    <td>@(@Model.finalReport.oNIVLMask + @Model.finalReport.oNIVLMaskChildren)</td>
                    <td colspan="3" class="bg-transparent border-0"></td>
                </tr>
                <tr class="border-transparent print-m-p-0">
                    <td class="fw-bold ">Лицевая маска</td>
                     @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td >@if(dr.oMask > 0) @dr.oMask </td>
                                        <td >@if(dr.oMaskChildren > 0) @dr.oMaskChildren </td>
                        }
                    }
                    <td>@Model.finalReport.oMask</td>
                    <td>@Model.finalReport.oMaskChildren</td>
                    <td>@(@Model.finalReport.oMask + @Model.finalReport.oMaskChildren)</td>
                    <td colspan="3" class="bg-transparent border-0"></td>
                </tr>

                <tr class="table-warning border-transparent print-m-p-0">
                    <td class="fw-bold  print-m-p-0">Количество пациентов на кислороде</td>
                     @{
                        foreach (int i in Model.oxygenSum)
                        {
                            <td colspan="2">@if(i>0)@i</td>
                        }
                    }
                    <td colspan="3" class="print-m-p-0">@(@Model.oxygenSum.Sum())</td>
                    <td colspan="3" class="bg-transparent border-0 print-m-p-0"> </td>
                </tr>

                <tr class="border-transparent print-m-p-0 pba-always">
                    <td class="fw-bold">Беременные</td>
                     @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td colspan="2">@if(dr.pregnant > 0) @dr.pregnant </td>
                        }
                    }                
                    <td>@Model.finalReport.pregnant</td>
                    <td>@Model.finalReport.pregnantChildren</td>
                    <td>@(@Model.finalReport.pregnant + @Model.finalReport.pregnantChildren)</td>
                    <td colspan="3" class="bg-transparent border-0"></td>
                </tr>
                <tr class="border-transparent print-m-p-0 ">
                    <td class="fw-bold">Пациенты из зон отдыха</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td>@if(dr.restZone > 0) @dr.restZone </td>
                                        <td>@if (dr.restZoneChildrens > 0) @dr.restZoneChildrens </td>
                        }
                    }
                    <td>@Model.finalReport.restZone</td>
                    <td>@Model.finalReport.restZoneChildren</td>
                    <td>@(@Model.finalReport.restZone + @Model.finalReport.restZoneChildren)</td>
                    <td colspan="3" class="bg-transparent border-0"></td>
                </tr>
