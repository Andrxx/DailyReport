                    <td class="print-m-p-0" colspan="@(@Model.departmentCounter*2+3)"></td>
                    <td colspan="3" class="bg-transparent border-0 print-m-p-0"></td>
                </tr>
                <tr class="table-secondary border-transparent print-m-p-0">
