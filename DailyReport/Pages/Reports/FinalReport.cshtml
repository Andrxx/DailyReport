                        {
                                        <td>@if(dr.outRegions > 0) @dr.outRegions </td>
                                        <td>@if (dr.outRegionsChildrens > 0) @dr.outRegionsChildrens </td>
                        }
                    }
                    <td>@Model.finalReport.outRegions</td>
                    <td>@Model.finalReport.outRegionsChildren</td>
                    <td>@(@Model.finalReport.outRegions + @Model.finalReport.outRegionsChildren)</td>
                    <td colspan="3" class="bg-transparent border-0"></td>
                </tr>
                <tr class="border-transparent print-m-p-0 ">
                    <td class="fw-bold">Иностранные граждне</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td>@if(dr.forein > 0) @dr.forein </td>
                                        <td>@if (dr.foreinChildrens > 0) @dr.foreinChildrens </td>
                        }
                    }
                    <td>@Model.finalReport.forein</td>
                    <td>@Model.finalReport.foreinChildren</td>
                    <td>@(@Model.finalReport.forein + @Model.finalReport.foreinChildren)</td>
                    <td colspan="3" class="bg-transparent border-0"></td>
                </tr>
                <tr class="border-transparent print-m-p-0">
                    <td class="fw-bold">Прибывшие из присоединенных областей (ЛНР, ДНР, ХО, ЗО)</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td>@if(dr.LNR_DNR > 0) @dr.LNR_DNR </td>
                                        <td>@if (dr.LNR_DNRChildrens > 0) @dr.LNR_DNRChildrens </td>
                        }
                    }
                    <td>@Model.finalReport.LNR_DNR</td>
                    <td>@Model.finalReport.LNR_DNRChildren</td>
                    <td>@(@Model.finalReport.LNR_DNR + @Model.finalReport.LNR_DNRChildren)</td>
                    <td colspan="3" class="bg-transparent border-0"></td>
                </tr>
                <tr class="border-transparent print-m-p-0">
                    <td class="fw-bold print-m-p-0">Прибывшие из иных территорий Украины</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td>@if(dr.otherUkrane > 0) @dr.otherUkrane</td>
                                        <td>@if (dr.otherUkraneChildren > 0) @dr.otherUkraneChildren</td>
                        }
                    }
                    <td>@Model.finalReport.otherUkrane</td>
                    <td>@Model.finalReport.otherUkraneChildren</td>
                    <td>@(@Model.finalReport.otherUkrane + @Model.finalReport.otherUkraneChildren)</td>
                    <td colspan="3" class="bg-transparent border-0"></td>
                </tr>
                <tr class="border-transparent print-m-p-0">
                    <td class="fw-bold">Всего пациентов, прибывших с территории Украины</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                <td>@if((dr.otherUkrane > 0)||(dr.LNR_DNR > 0)) @( @dr.otherUkrane + dr.LNR_DNR)</td>
                                <td>@if ((dr.otherUkraneChildren > 0)||(dr.LNR_DNRChildrens > 0)) @(@dr.otherUkraneChildren + dr.LNR_DNRChildrens)</td>
                        }
                    }
                    <td>@(@Model.finalReport.otherUkrane + @Model.finalReport.LNR_DNR)</td>
                    <td>@(@Model.finalReport.otherUkraneChildren + @Model.finalReport.LNR_DNRChildren)</td>
                    <td>@(@Model.finalReport.otherUkrane + @Model.finalReport.otherUkraneChildren + @Model.finalReport.LNR_DNR 
                        + @Model.finalReport.LNR_DNRChildren)</td>
                    <td colspan="3" class="bg-transparent border-0"></td>
                </tr>
                <tr class="border-transparent print-m-p-0">
                    <td class="fw-bold">Поступили переводом из другой МО</td>
                     @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td>@if(dr.incomeHospital > 0) @dr.incomeHospital </td>
                                        <td>@if (dr.incomeHospitalChildrens > 0) @dr.incomeHospitalChildrens </td>
                        }
                    }
                    <td>@Model.finalReport.incomeHospital</td>
                    <td>@Model.finalReport.incomeHospitalChildren</td>
                    <td>@(@Model.finalReport.incomeHospital + @Model.finalReport.incomeHospitalChildren)</td>
                    <td colspan="3" class="bg-transparent border-0"></td>
                </tr>
                <tr class="border-transparent print-m-p-0">
                    <td class="fw-bold">Переведены в другое МО</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td>@if(dr.outcomeHospital > 0) @dr.outcomeHospital </td>
                                        <td>@if (dr.outcomeHospitalChildrens > 0) @dr.outcomeHospitalChildrens </td>
                        }
                    }
                    <td>@Model.finalReport.outcomeHospital</td>
