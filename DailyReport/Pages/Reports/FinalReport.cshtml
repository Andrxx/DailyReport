@page
@using DailyReport.Models
@model DailyReport.Pages.Reports.FinalReportModel
@{
    ViewData["Title"] = "Сводка по больнице";
}

<div class="container">
    <div class="row m-0 p-0">
        <table class="table m-0 p-0 table-bordered border-dark text-center print-m-p-0" id="main_table">
            <tbody>
                @*строка мест*@
                <tr class="table-primary fw-bold m-0 p-0 print-m-p-0">
                    <td class="print-m-p-0">@Model.reportDate.ToString("dd.MM.yy")</td>
                    @{
                        foreach (Department dep in Model.activeDepartments)
                        {
                            <td class="print-m-p-0" colspan=2>
                                @dep.Name (@(@dep.ChildrenSpotsQuantity + @dep.AdultSpotsQuantity) коек)
                            </td>
                        }
                    }
                    <td class="print-m-p-0" colspan="3">
                        @(@Model.AdultSpotsSum + @Model.ChildrenSpotsSum) стационарных коек,
                        кроме того @(@Model.ORITAdults + Model.ORITChildren) коек ОРИТ
                    </td>
                    <td class="print-m-p-0" colspan="3">
                        Всего @(@Model.AdultSpotsSum  + @Model.ChildrenSpotsSum) с учетом
                        дневного стационара, кроме того @(@Model.ORITAdults + Model.ORITChildren) коек ОРИТ
                    </td>
                </tr>

                @*строка разделения взр/дети*@
                <tr class="table-secondary align-bottom  m-0 p-0">
                    <td class="fw-bold  print-m-p-0">
                        Всего: взрослые @Model.AdultSpotsSum, детские @Model.ChildrenSpotsSum
                    </td>
                    @{
                        for (int i= 0; i < @Model.departmentCounter; i++)
                        {
                            <td class="print-m-p-0">Взр</td>
                            <td class="print-m-p-0">Дет</td>
                        }
                    }
                    <td class="print-m-p-0">Взр</td>
                    <td class="print-m-p-0">Дет</td>
                    <td class="print-m-p-0">Всего</td>
                    <td class="print-m-p-0">Взр</td>
                    <td class="print-m-p-0">Дет</td>
                    <td class="print-m-p-0">Всего</td>                   
                </tr>

             

                @*строка фактические койки*@
                <tr class="table-secondary  m-0 p-0">
                    <td class="fw-bold  print-m-p-0">Количество коек (фактическое)</td>

                    @{

                        foreach (Department dep in Model.activeDepartments)
                        {
                            <td class="print-m-p-0">@dep.AdultSpotsQuantity</td>
                            <td class="print-m-p-0">@dep.ChildrenSpotsQuantity</td>
                        }
                        //костыль для вывода мест орит

                    }

                    <td class="print-m-p-0">@Model.AdultSpotsSum</td>
                    <td class="print-m-p-0">@Model.ChildrenSpotsSum</td>
                    <td class="print-m-p-0">@(@Model.AdultSpotsSum + @Model.ChildrenSpotsSum)</td>
                    <td class="print-m-p-0">@Model.AdultFullSpotsSum</td>
                    <td class="print-m-p-0">@Model.ChildrenFullSpotsSum</td>
                    <td class="print-m-p-0">@(@Model.AdultFullSpotsSum + @Model.ChildrenFullSpotsSum)</td>
                </tr>



                <tr class="table-success print-m-p-0">
                    <td class="fw-bold print-m-p-0">Состояло</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                            <td class="print-m-p-0">@if(dr.existed > 0) {@dr.existed}</td>
                            <td class="print-m-p-0">@if (dr.existedChildren > 0)
                                {
                                    @dr.existedChildren
                                }</td>
                        }
                    }


                    <td class="print-m-p-0">@Model.finalReport.existed</td>
                    <td class="print-m-p-0">@Model.finalReport.existedChildren</td>
                    <td class="print-m-p-0">@(@Model.finalReport.existed + @Model.finalReport.existedChildren)</td>

                    <td class="print-m-p-0">@(@Model.finalReport.existed)</td>
                    <td class="print-m-p-0">@(@Model.finalReport.existedChildren)</td>
                    <td class="print-m-p-0">@(@Model.finalReport.existed + @Model.finalReport.existedChildren)</td>
                </tr>
                <tr class="print-m-p-0">
                    <td class="fw-bold print-m-p-0">Поступило</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td class="print-m-p-0">@if(dr.income > 0) {@dr.income}</td>
                            <td class="print-m-p-0">@if (dr.incomeChildrens > 0)
                                {
                                    @dr.incomeChildrens
                                }</td>
                        }
                    }
                    <td class="print-m-p-0">@Model.finalReport.income</td>
                    <td class="print-m-p-0">@Model.finalReport.incomeChildren</td>
                    <td class="print-m-p-0">@(@Model.finalReport.income + @Model.finalReport.incomeChildren)</td>
                    <td class="print-m-p-0">@(@Model.finalReport.income)</td>
                    <td class="print-m-p-0">@(@Model.finalReport.incomeChildren)</td>
                    <td class="print-m-p-0">@(@Model.finalReport.income + @Model.finalReport.incomeChildren)</td>
                </tr>
                <tr class="table-success print-m-p-0">
                    <td class="fw-bold">Выбыло</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td>@if(dr.outcome > 0) {@dr.outcome}</td>
                                        <td>@if(dr.outcomeChildrens > 0) {@dr.outcomeChildrens}</td>
                        }
                    }
                    <td>@Model.finalReport.outcome</td>
                    <td>@Model.finalReport.outcomeChildren</td>
                    <td>@(@Model.finalReport.outcome + @Model.finalReport.outcomeChildren)</td>
                    <td>@(@Model.finalReport.outcome)</td>
                    <td>@(@Model.finalReport.outcomeChildren )</td>
                    <td>@(@Model.finalReport.outcome + @Model.finalReport.outcomeChildren)</td>
                </tr>

                <tr class="table-secondary print-m-p-0">
                    <td class="fw-bold">Прикреплено в ОРИТ</td>

                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td>@if(dr.attachedToORIT > 0) {@dr.attachedToORIT}</td>
                                        <td>@if(dr.attachedToORITCildrens > 0) {@dr.attachedToORITCildrens}</td>
                        }
                    }
                    <td>@Model.finalReport.attachedToORIT</td>
                    <td>@Model.finalReport.attachedToORITChildren</td>
                    <td>@(@Model.finalReport.attachedToORIT + @Model.finalReport.attachedToORITChildren)</td>
                    <td>@(@Model.finalReport.attachedToORIT)</td>
                    <td>@(@Model.finalReport.attachedToORITChildren)</td>
                    <td>@(@Model.finalReport.attachedToORIT + @Model.finalReport.attachedToORITChildren)</td>
                </tr>
                <tr class="table-secondary print-m-p-0">
                    <td class="fw-bold">Переведено из отделения</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td>@if(dr.movedOutDep > 0) {@dr.movedOutDep}</td>
                                        <td>@if(dr.movedOutDepChildrens > 0) {@dr.movedOutDepChildrens}</td>
                        }
                    }
                    <td>@Model.finalReport.movedOutDep</td>
                    <td>@Model.finalReport.movedOutDepChildren</td>
                    <td>@(@Model.finalReport.movedOutDep + @Model.finalReport.movedOutDepChildren)</td>
                    <td>@(@Model.finalReport.movedOutDep)</td>
                    <td>@(@Model.finalReport.movedOutDepChildren)</td>
                    <td>@(@Model.finalReport.movedOutDep + @Model.finalReport.movedOutDepChildren)</td>
                </tr>
                <tr class="table-secondary print-m-p-0">
                    <td class="fw-bold">Переведено в отделение</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td>@if(dr.movedInDep > 0) {@dr.movedInDep}</td>
                                        <td>@if(dr.movedInDepChildrens > 0) {@dr.movedInDepChildrens}</td>
                        }
                    }
                    <td>@Model.finalReport.movedInDep</td>
                    <td>@Model.finalReport.movedInDepChildren</td>
                    <td>@(@Model.finalReport.movedInDep + @Model.finalReport.movedInDepChildren)</td>
                    <td>@(@Model.finalReport.movedInDep)</td>
                    <td>@(@Model.finalReport.movedInDepChildren)</td>
                    <td>@(@Model.finalReport.movedInDep + @Model.finalReport.movedInDepChildren)</td>
                </tr>
                <tr class="table-secondary print-m-p-0">
                    <td class="fw-bold">Умерло</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                                        <td>@if(dr.died > 0) {@dr.died}</td>
                                        <td>@if(dr.diedChildrens > 0) {@dr.diedChildrens}</td>
                        }
                    }
                    <td>@Model.finalReport.died</td>
                    <td>@Model.finalReport.diedChildren</td>
                    <td>@(@Model.finalReport.died + @Model.finalReport.diedChildren)</td>
                    <td>@(@Model.finalReport.died)</td>
                    <td>@(@Model.finalReport.diedChildren)</td>
                    <td>@(@Model.finalReport.died + @Model.finalReport.diedChildren)</td>
                </tr>
                <tr class="print-m-p-0">
                    <td class="fw-bold print-m-p-0">Состоит в отделении</td>
                    @{
                        foreach (DepReport dr in Model.sortedReports)
                        {
                            <td class="print-m-p-0">@if(dr.present > 0) {@dr.present}</td>
                            <td class="print-m-p-0">@if (dr.presentChildrens > 0){@dr.presentChildrens}</td>
                        }
                    }
                    <td class="print-m-p-0">@Model.finalReport.present</td>
                    <td class="print-m-p-0">@Model.finalReport.presentChildren</td>
                    <td class="print-m-p-0">@(@Model.finalReport.present + @Model.finalReport.presentChildren)</td>
                    <td class="print-m-p-0">@(@Model.finalReport.present)</td>
                    <td class="print-m-p-0">@(@Model.finalReport.presentChildren)</td>
                    <td class="print-m-p-0">@(@Model.finalReport.present + @Model.finalReport.presentChildren)</td>
                </tr>
               @*  <tr class="table-secondary border-transparent print-m-p-0">
                    <td class="fw-bold">Свободные места</td>
                    
                    <td colspan="2">@(@Model.freeSpots.dep1S @*+ @Model.freeSpots.dep1Children@)</td>
                    <td colspan="2">@(@Model.freeSpots.dep11S @*+ @Model.freeSpots.dep11Children@)</td>
                    <td colspan="2">@(@Model.freeSpots.dep3S @*+ @Model.freeSpots.dep3Children@)</td>
                    @*<td colspan="2">@(@Model.freeSpots.dep31S @*+ @Model.freeSpots.dep3Children)</td>@
                    <td colspan="2">@(@Model.freeSpots.dep4S @*+ @Model.freeSpots.dep4Children@)</td>
                    <td colspan="2">@(@Model.freeSpots.dep5S @*+ @Model.freeSpots.dep5Children@)</td>
                    <td colspan="2">@(@Model.freeSpots.dep51S @* + @Model.freeSpots.dep5Children@)</td>
