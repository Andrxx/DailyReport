@page
@using DailyReport.Models
@model IndexModel
@{
    ViewData["Title"] = "Сводка ИБ2";
}

<div class="text-center">
    <h1 class="display-4">Сводка отделений</h1>

    @{
        foreach (Department dep in Model.Departments)
        {
            <p><a href="Reports\DepReport?depAllias=@dep.Allias">@dep.Name </a></p>
        }
    }
    
    @*Вывод вспомогательных отделений*@
    @* <p><a href="Reports\DepReport?depAllias=81">КДО</a></p>
    <p><a href="Reports\DepReport?depAllias=82">Платные услуги</a></p> *@
    <p><a href="Reports\FinalReport">Сводка по больнице</a></p>
    <p><a href="Reports\FinalReport?dateOffset=-1&onlyView=true">Сводка для планерки</a></p>

</div>
