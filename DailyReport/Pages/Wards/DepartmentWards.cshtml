<template id="patient-row-template">
    <div class="row patient-row">
        <div class="col-2 name"></div>
        <div class="col-2 age"></div>
        <div class="col-1 male"></div>
        <div class="col-1 diagnos"></div>
        <div class="col-1 date"></div>
        <div class="col-1"><input type="checkbox" disabled></div>
        <div class="col-1"><input type="checkbox" disabled></div>
        <div class="col-2">
            <input type="button" value="&#9998" />
            <input type="button" value="&#128465" />
        </div>
    </div>
</template>

<template id="add-patient-form-template">
    <form method="post" class="row patient-row add-patient-form">
        <div class="col-2">
            <input type="text" name="Name" placeholder="Имя" required />
        </div>
        <div class="col-2">
            <input type="text" name="sAge" placeholder="Возраст" required />
        </div>
        <div class="col-1">
            <input type="text" name="Male" placeholder="Пол" required />
        </div>
        <div class="col-1">
            <input type="text" name="Diagnos" placeholder="Диагноз" required />
        </div>
        <div class="col-1">
            <input type="date" name="HospitalisationDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
        </div>
        <div class="col-1">
            <input class="form-check-input" type="checkbox" name="HasRash" />
        </div>
        <div class="col-1">
            <input class="form-check-input" type="checkbox" name="HasCareRisk" />
        </div>
        <div class="col-1">
            <input class="form-check-input" type="checkbox" name="IsUntochable" />
        </div>
        <div class="col-1">
            <input type="submit" value="+" class="btn btn-success" />
        </div>
    </form>
</template>