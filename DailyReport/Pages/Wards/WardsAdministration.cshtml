@page
@using DailyReport.Models
@model DailyReport.Pages.Wards.WardsAdministrationModel
@{
    ViewData["Title"] = "Администрирование(палаты)";
}
<div class="text-center">
    <h1 class="display-4">Регистрация палат</h1>

    <h1 class="display-4">Управление палатами</h1>
    @{
        foreach (Department dep in Model.Departments)
        {
            <p><a href="WardsManagement?depAllias=@dep.Allias">@dep.Name</a></p>
        }
    }
</div>