@page
@using DailyReport.Models
@model DailyReport.Pages.Wards.WardsIndexModel
@{
    ViewData["Title"] = "Управление палатами";
}
<div class="text-center">
    @*Палаты временно не указываем*@
    <h1 class="display-4">Управление палатами</h1>
    @{
        foreach (Department dep in Model.Departments)
        {
            <p><a href="DepartmentWards?depAllias=@dep.Allias">@dep.Name </a></p>
        }
    }
    <p><a href=" WardsSummary">Места по стационару</a></p>
</div>